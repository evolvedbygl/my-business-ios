{
  "sourceLanguage": "en",
  "strings": {
    "Number & street": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número y calle"
          }
        }
      }
    },
    "Edit Gold Life ID": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar Gold Life ID"
          }
        }
      }
    },
    "Couldn’t save. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. Inténtalo de nuevo."
          }
        }
      }
    },
    "Sign-in methods": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Métodos de inicio de sesión"
          }
        }
      }
    },
    "Couldn’t load your sign-in methods — check your connection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos cargar tus métodos de inicio de sesión. Revisa tu conexión."
          }
        }
      }
    },
    "The email addresses and phone numbers your one-time sign-in codes can be sent to.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los correos y números de teléfono a los que se pueden enviar tus códigos de un solo uso."
          }
        }
      }
    },
    "Primary": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Principal"
          }
        }
      }
    },
    "Make primary": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer principal"
          }
        }
      }
    },
    "Saved to your Gold Life ID. Every Gold Life app set to Gold Life ID Setting follows this.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardó en tu Gold Life ID. Cada app de Gold Life configurada en Ajuste de Gold Life ID sigue esto."
          }
        }
      }
    },
    "Delete Account": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar cuenta"
          }
        }
      }
    },
    "This app holds your data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app tiene tus datos guardados."
          }
        }
      }
    },
    "Couldn’t check this app. Open it and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos verificar esta app. Ábrela e inténtalo de nuevo."
          }
        }
      }
    },
    "Confirm it’s you to delete your Gold Life ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que eres tú para eliminar tu Gold Life ID."
          }
        }
      }
    },
    "0": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0"
