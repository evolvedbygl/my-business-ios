    "Sharing sends two files for %@ — this tax summary and a receipts CSV listing every expense. Hand them to your accountant or keep them for your records.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al compartir se envían dos archivos de %@ — este resumen de impuestos y un CSV de recibos que lista cada gasto. Entrégaselos a tu contador o guárdalos para tus registros."
          }
        }
      }
    },
    "Show address on documents": {
      "localizations": {
