    "Try Again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentar de nuevo"
          }
        }
      }
    },
    "Turn the card over": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltear la tarjeta"
          }
        }
      }
    },
    "Turn the Pay button on for each invoice yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa tú mismo el botón de pago en cada factura."
          }
        }
      }
    },
    "Turning this estimate into an invoice": {
      "localizations": {
