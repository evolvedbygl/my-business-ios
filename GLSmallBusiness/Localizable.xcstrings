    "%lld options": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld opciones"
          }
        }
      }
    },
    "Card payments aren’t part of sample data — sign in with your own account to set them up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos con tarjeta no son parte de los datos de ejemplo — inicia sesión con tu propia cuenta para configurarlos."
          }
        }
      }
    },
    "Chosen Options": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opciones elegidas"
          }
        }
      }
    },
    "Combine into one total": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar en un solo total"
          }
        }
      }
    },
    "Convert": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir"
          }
        }
      }
    },
    "Each option is priced on its own — choose the one that works best.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opción tiene su propio precio — elige la que mejor te convenga."
          }
        }
      }
    },
    "Each option stands on its own — there is no combined total.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada opción es independiente — no hay un total combinado."
          }
        }
      }
    },
    "Not available in sample data": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en los datos de ejemplo"
          }
        }
      }
    },
    "Off, each group is a standalone option with its own total — send choices in one PDF.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagado, cada grupo es una opción independiente con su propio total — envía opciones en un solo PDF."
          }
        }
      }
    },
    "On: everything adds into one total. Off: each group is its own priced option the customer can choose from.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encendido: todo se suma en un solo total. Apagado: cada grupo es una opción con su propio precio para que el cliente elija."
          }
        }
      }
    },
    "Option": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opción"
          }
        }
      }
    },
    "Option total": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Total de la opción"
          }
        }
      }
    },
    "Option total  %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Total de la opción  %@"
          }
        }
      }
    },
    "Priced as options": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precios por opción"
          }
        }
      }
    },
    "That change didn’t save": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese cambio no se guardó"
          }
        }
      }
    },
    "The App Store isn’t offering this subscription at the moment. Please try again later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no está ofreciendo esta suscripción en este momento. Intenta de nuevo más tarde."
          }
        }
      }
    },
    "This estimate already has an invoice. Converting again is fine if the customer chose another option — otherwise it bills the job twice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este presupuesto ya tiene una factura. Convertirlo de nuevo está bien si el cliente eligió otra opción — de lo contrario, cobrarías el trabajo dos veces."
          }
        }
      }
    },
    "Those options are no longer on this estimate. Pull down to refresh, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esas opciones ya no están en este presupuesto. Desliza hacia abajo para actualizar y vuelve a intentarlo."
          }
        }
      }
    },
    "Totals": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Totales"
          }
        }
      }
    },
    "Your device couldn’t write the change. Free up storage if it’s low, then open the record and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo no pudo guardar el cambio. Libera espacio si queda poco y vuelve a abrir el registro para intentarlo de nuevo."
          }
        }
      }
    },
    "·": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "·"
          }
        }
      }
    },
    "· %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@"
          }
        }
      }
    },
    "· −%@ off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· −%@ de descuento"
          }
        }
      }
    },
    "· added": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· agregado"
          }
        }
      }
    },
    "· non-taxable": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· no gravable"
          }
        }
      }
    },
    "“Book one job at a time” is on. All-day jobs warn on the same day; timed jobs warn when the times overlap.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Agenda un trabajo a la vez” está activado. Los trabajos de todo el día avisan si caen el mismo día; los trabajos con horario avisan cuando se traslapan los horarios."
          }
        }
      }
    },
    "*": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "*"
          }
        }
      }
    },
    "% off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "% de descuento"
          }
        }
      }
    },
    "%@ – %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ – %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – %@"
          }
        }
      }
    },
    "%@ — %@, still valid but renew it soon.": {
      "comment": "A sentence that ends with a comma.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$@, still valid but renew it soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@, aún vigente pero renuévalo pronto."
          }
        }
      }
    },
    "%@ — EXPIRED. Send it and your customer will likely reject it; upload a current one first.": {
      "comment": "A description of an expired certificate. The argument is the name of the certificate.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — VENCIDO. Si lo envías, es probable que tu cliente lo rechace; sube uno vigente primero."
          }
        }
      }
    },
    "%@ — not a PDF or a photo we can open, so it won’t be included. Replace it to send it.": {
      "comment": "A description of a certificate that is not a PDF or a photo. The argument is the customer's name.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — no es un PDF ni una foto que podamos abrir, así que no se incluirá. Reemplázalo para enviarlo."
          }
        }
      }
    },
    "%@ — sent as provided.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — se envía tal cual."
          }
        }
      }
    },
    "%@ — still valid, but renew it soon.": {
      "comment": "A description of a certificate that is about to expire. The argument is a human-readable date.",
