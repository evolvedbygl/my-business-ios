          }
        }
      }
    },
    "By tapping “Sign & Confirm”, you certify that you have reviewed the terms of this contract and agree to be bound by them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar “Firmar y confirmar”, certificas que has revisado los términos de este contrato y aceptas quedar vinculado por ellos."
          }
        }
      }
    },
    "The job site or property address where work is performed. When different from billing, this will auto-fill into new estimates and contracts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección del lugar de trabajo o propiedad donde se realiza el trabajo. Cuando sea diferente a la de facturación, se completará automáticamente en nuevos presupuestos y contratos."
          }
        }
      }
    },
    "Generates an invoice for 100% of the remaining contract balance and all approved change orders.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera una factura por el 100% del saldo restante del contrato y todas las órdenes de cambio aprobadas."
          }
        }
      }
    },
    "Invoice a progress payment or deposit as a percentage of the total contract value.": {
      "localizations": {
        "es": {
