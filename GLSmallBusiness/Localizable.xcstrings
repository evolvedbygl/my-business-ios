          }
        }
      }
    },
    "What you type or say to the assistant": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribes o le dices al asistente"
          }
        }
      }
    },
    "Who owes me money right now?": {
      "localizations": {
        "es": {
          "stringUnit": {
