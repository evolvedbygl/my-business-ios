    "%@ needs an active subscription. Everything you already have is still here to read — nothing can be added, changed or exported until you reactivate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere una suscripción activa. Todo lo que ya tienes sigue aquí para consultarlo: no se puede agregar, cambiar ni exportar nada hasta que reactives."
          }
        }
      }
    },
