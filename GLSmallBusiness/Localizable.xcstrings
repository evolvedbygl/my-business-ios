            "value": "Total de gastos"
          }
        }
      }
    },
    "TOTAL PAID": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TOTAL PAGADO"
          }
        }
      }
    },
    "Trust / Estate": {
      "localizations": {
        "es": {
          "stringUnit": {
